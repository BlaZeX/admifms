---
const {
  placementsSheet = "MSc_Placements",
  recruitersSheet = "MSc_Recruiters",
  placementTitle = "MSc. Students Placed",
  placementDescription = "Our students are placed in top tier financial institutions, analytics firms and corporate treasury offices. Here is the academic year-wise placement overview.",
  recruitersTitle = "Key Recruiters",
  recruitersDescription = "Leading organizations that regularly recruit from our MSc. Finance programme.",
  recruiterMarqueeMode = "fixed",
  recruiterDisplay = "marquee",
} = Astro.props;
---

<div
  class="msc-placements-wrapper"
  id="msc-placements-root"
  data-placements-sheet={placementsSheet}
  data-recruiters-sheet={recruitersSheet}
  data-recruiter-marquee-mode={recruiterMarqueeMode}
  data-recruiter-display={recruiterDisplay}
>
  <!-- Placements Section (Dynamically Loaded) -->
  <div id="placements-container" class="placements-section hidden">
    <div class="section-header">
      <h2>{placementTitle}</h2>
      <p>{placementDescription}</p>
    </div>

    <div class="table-card">
      <div class="table-responsive">
        <table class="styled-table">
          <thead>
            <tr>
              <th scope="col" style="width: 100px;">Sr No.</th>
              <th scope="col">Academic Year</th>
              <th scope="col">Highest CTC</th>
              <th scope="col">Average CTC</th>
            </tr>
          </thead>
          <tbody id="placements-tbody">
            <!-- Populated dynamically client-side -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Recruiters Section (Dynamically Loaded) -->
  <div id="recruiters-container" class="recruiters-section hidden">
    <div class="section-header">
      <h2>{recruitersTitle}</h2>
      <p>{recruitersDescription}</p>
    </div>

    <div class="recruiter-tools hidden" id="recruiter-tools">
      <div>
        <label class="recruiter-search-label" for="recruiter-search">Search recruiters</label>
        <input id="recruiter-search" class="recruiter-search" type="search" placeholder="Search company name" />
      </div>
      <p class="recruiter-count" id="recruiter-count"></p>
    </div>

    <div class="recruiter-grid hidden" id="recruiter-grid">
      <!-- Populated dynamically client-side -->
    </div>

    <div class="recruiter-grid-actions hidden" id="recruiter-grid-actions">
      <button class="button button-secondary recruiter-toggle" id="recruiter-toggle" type="button">
        Show all recruiters
      </button>
    </div>

    <div class="marquee-wrapper" id="recruiter-marquee-wrapper">
      <div class="marquee-content" id="recruiters-marquee">
        <!-- Populated dynamically client-side -->
      </div>
    </div>
  </div>

  <!-- Client-Side Skeleton Loader -->
  <div id="placements-loader" class="placements-loader-container">
    <div class="skeleton-wrapper">
      <div class="skeleton-header"></div>
      <div class="skeleton-table"></div>
    </div>
  </div>
</div>

<script>
  import { fetchSheet, normalizeDriveImageLink } from "../utils/googleSheets.js";

  const escapeHtml = (value) =>
    String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  const loadDynamicData = async () => {
    try {
      const root = document.getElementById("msc-placements-root");
      const placementsSheet =
        root?.dataset.placementsSheet || "MSc_Placements";
      const recruitersSheet =
        root?.dataset.recruitersSheet || "MSc_Recruiters";

      const [placements, recruiters] = await Promise.all([
        fetchSheet(placementsSheet),
        fetchSheet(recruitersSheet),
      ]);

      const placementsContainer = document.getElementById(
        "placements-container",
      );
      const recruitersContainer = document.getElementById(
        "recruiters-container",
      );
      const loader = document.getElementById("placements-loader");

      if (placements && placements.length > 0) {
        const tbody = document.getElementById("placements-tbody");
        if (tbody) {
          tbody.innerHTML = placements
            .map((row) => {
              const srNo =
                row["Sr No."] || row["sr no."] || row["Sr. No."] || "-";
              const academicYear =
                row["Academic Year"] || row["academic year"] || "-";
              const highestCtc =
                row["Highest CTC"] || row["highest ctc"] || "-";
              const averageCtc =
                row["Average CTC"] || row["average ctc"] || "-";

              return `
                <tr>
                  <td class="sr-no" style="text-align: center;">${srNo}</td>
                  <td class="academic-year" style="text-align: center;">${academicYear}</td>
                  <td class="ctc highest-ctc" style="text-align: center;">${highestCtc}</td>
                  <td class="ctc average-ctc" style="text-align: center;">${averageCtc}</td>
                </tr>
              `;
            })
            .join("");

          placementsContainer.classList.remove("hidden");
        }
      }

      if (recruiters && recruiters.length > 0) {
        const displayMode = root?.dataset.recruiterDisplay || "marquee";
        const marquee = document.getElementById("recruiters-marquee");
        const marqueeWrapper = document.getElementById(
          "recruiter-marquee-wrapper",
        );
        const grid = document.getElementById("recruiter-grid");
        const tools = document.getElementById("recruiter-tools");
        const search = document.getElementById("recruiter-search");
        const count = document.getElementById("recruiter-count");
        const actions = document.getElementById("recruiter-grid-actions");
        const toggle = document.getElementById("recruiter-toggle");
        const recruiterCount = recruiters.length;

        if (displayMode === "grid" && grid) {
          const initialLimit = 24;
          let expanded = false;
          let query = "";

          const normalizedRecruiters = recruiters.map((recruiter) => {
            const logoUrl = recruiter["Logo URL"] || recruiter["logo url"] || "";
            const companyName =
              recruiter["Company Name"] ||
              recruiter["company name"] ||
              "Recruiter";

            return {
              companyName,
              companyNameSafe: escapeHtml(companyName),
              logoUrl,
            };
          });

          const renderGrid = () => {
            const filtered = normalizedRecruiters.filter((recruiter) =>
              recruiter.companyName.toLowerCase().includes(query),
            );
            const visible = expanded
              ? filtered
              : filtered.slice(0, initialLimit);

            grid.innerHTML = visible
              .map(
                (recruiter) => `
                  <div class="recruiter-logo recruiter-logo--grid" title="${recruiter.companyNameSafe}">
                    ${
                      recruiter.logoUrl
                        ? `<img src="${normalizeDriveImageLink(recruiter.logoUrl)}" alt="${recruiter.companyNameSafe} Logo" loading="lazy" />`
                        : `<span class="company-text">${recruiter.companyNameSafe}</span>`
                    }
                  </div>
                `,
              )
              .join("");

            if (count) {
              const suffix =
                filtered.length === recruiterCount
                  ? `${recruiterCount} recruiters`
                  : `${filtered.length} of ${recruiterCount} recruiters`;
              count.textContent = suffix;
            }

            if (actions && toggle) {
              const shouldShowToggle = filtered.length > initialLimit;
              actions.classList.toggle("hidden", !shouldShowToggle);
              toggle.textContent = expanded
                ? "Show fewer recruiters"
                : `Show all ${filtered.length} recruiters`;
            }
          };

          if (marqueeWrapper) marqueeWrapper.classList.add("hidden");
          grid.classList.remove("hidden");
          if (tools) tools.classList.remove("hidden");

          if (search) {
            search.addEventListener("input", () => {
              query = search.value.trim().toLowerCase();
              expanded = Boolean(query);
              renderGrid();
            });
          }

          if (toggle) {
            toggle.addEventListener("click", () => {
              expanded = !expanded;
              renderGrid();
            });
          }

          renderGrid();
          recruitersContainer.classList.remove("hidden");
        } else if (marquee) {
          const recruiterCount = recruiters.length;
          const duration =
            root?.dataset.recruiterMarqueeMode === "scaled"
              ? Math.min(Math.max(recruiterCount * 2.4, 45), 240)
              : 30;
          const recruiterHtml = recruiters
            .map((recruiter) => {
              const logoUrl =
                recruiter["Logo URL"] || recruiter["logo url"] || "";
              const companyName =
                recruiter["Company Name"] ||
                recruiter["company name"] ||
                "Recruiter";

              return `
                <div class="recruiter-logo" title="${companyName}">
                  ${
                    logoUrl
                      ? `<img src="${normalizeDriveImageLink(logoUrl)}" alt="${companyName} Logo" loading="lazy" />`
                      : `<span class="company-text">${companyName}</span>`
                  }
                </div>
              `;
            })
            .join("");

          // Duplicate the list of logos for infinite marquee effect
          marquee.innerHTML = recruiterHtml + recruiterHtml;
          marquee.style.setProperty("--marquee-duration", `${duration}s`);
          marquee.setAttribute(
            "aria-label",
            `${recruiterCount} recruiters`,
          );
          recruitersContainer.classList.remove("hidden");
        }
      }

      if (loader) {
        loader.classList.add("hidden");
      }
    } catch (error) {
      console.error("Error loading placements dynamically:", error);
      const loader = document.getElementById("placements-loader");
      if (loader) loader.classList.add("hidden");
    }
  };

  // Run on page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadDynamicData);
  } else {
    loadDynamicData();
  }
</script>

<style>
  .hidden {
    display: none !important;
  }

  .placements-section {
    margin-bottom: 4.5rem;
  }

  .recruiters-section {
    margin-bottom: 4.5rem;
  }

  /* Section Header styling to match current site */
  .section-header {
    max-width: 820px;
    margin: 0 0 2rem;
  }

  .section-header h2 {
    position: relative;
    padding-bottom: 14px;
    margin-bottom: 12px;
    color: var(--navy-950);
    font-family: "Outfit", sans-serif;
    font-size: clamp(1.45rem, 2.5vw, 2.25rem);
    font-weight: 700;
  }

  .section-header h2::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 60px;
    height: 3px;
    background-color: var(--blue-700);
  }

  .section-header p {
    color: var(--muted);
    font-size: 1.05rem;
    margin-top: 0.8rem;
    line-height: 1.6;
  }

  /* Table styles */
  .table-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
    box-shadow: rgba(0, 0, 0, 0.04) 0px 4px 20px 0px;
    overflow: hidden;
  }

  .table-responsive {
    overflow-x: auto;
    width: 100%;
    -webkit-overflow-scrolling: touch;
  }

  .styled-table {
    width: 100%;
    border-collapse: collapse;
    font-family: "Plus Jakarta Sans", sans-serif;
  }

  .styled-table th {
    background-color: var(--navy-950);
    color: #ffffff;
    text-align: left;
    padding: 1rem 1.25rem;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .styled-table th:first-child {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
  }

  .styled-table th:last-child {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
  }

  :global(.styled-table td) {
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 0.95rem;
  }

  /* Responsive Table Styling for Small Screens */
  @media (max-width: 768px) {
    .styled-table th,
    :global(.styled-table td) {
      padding: 0.8rem 0.75rem;
      font-size: 0.88rem;
    }
  }

  @media (max-width: 480px) {
    .table-card {
      padding: 0.5rem;
    }

    .styled-table th,
    :global(.styled-table td) {
      padding: 0.65rem 0.5rem;
      font-size: 0.8rem;
    }

    /* Adjust the specific width of Sr No. col on extra small screens */
    .styled-table th[style] {
      width: 65px !important;
    }
  }

  :global(.styled-table tbody tr:last-child td) {
    border-bottom: none;
  }

  :global(.styled-table tbody tr) {
    transition: background-color 0.2s ease;
  }

  :global(.styled-table tbody tr:hover) {
    background-color: rgba(57, 73, 171, 0.04);
  }

  :global(.sr-no) {
    font-weight: 600;
    color: var(--muted);
  }

  :global(.academic-year) {
    font-weight: 700;
    color: var(--navy-950);
  }

  :global(.ctc) {
    font-weight: 600;
  }

  :global(.highest-ctc) {
    color: var(--green-700);
  }

  :global(.average-ctc) {
    color: var(--blue-700);
  }

  .recruiter-tools {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .recruiter-search-label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--navy-950);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .recruiter-search {
    width: min(360px, 88vw);
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: #ffffff;
    color: var(--text);
    font: inherit;
  }

  .recruiter-search:focus {
    outline: 3px solid rgba(255, 193, 7, 0.45);
    border-color: var(--blue-700);
  }

  .recruiter-count {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .recruiter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(142px, 1fr));
    gap: 0.85rem;
    padding: 1rem;
    background-color: var(--surface-soft);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .recruiter-grid-actions {
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
  }

  /* Infinite Scrolling Marquee */
  .marquee-wrapper {
    overflow: hidden;
    position: relative;
    width: 100%;
    padding: 1.75rem 0;
    background-color: var(--surface-soft);
    border: 1px solid var(--border);
    border-radius: 12px;
    display: flex;
    align-items: center;
  }

  /* Fade gradient overlays on left and right for seamless look */
  .marquee-wrapper::before,
  .marquee-wrapper::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee-wrapper::before {
    left: 0;
    background: linear-gradient(to right, var(--surface-soft), transparent);
  }

  .marquee-wrapper::after {
    right: 0;
    background: linear-gradient(to left, var(--surface-soft), transparent);
  }

  .marquee-content {
    display: flex;
    gap: 2.25rem;
    animation: marquee-loop var(--marquee-duration, 60s) linear infinite;
    white-space: nowrap;
    will-change: transform;
    align-items: center;
  }

  .marquee-wrapper:hover .marquee-content {
    animation-play-state: paused;
  }

  :global(.recruiter-logo) {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 148px;
    height: 66px;
    padding: 0.5rem;
    background-color: #ffffff;
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  :global(.recruiter-logo:hover) {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }

  :global(.recruiter-logo--grid) {
    width: 100%;
    height: 76px;
  }

  :global(.recruiter-logo img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  :global(.recruiter-logo:hover img) {
    filter: grayscale(0%);
    opacity: 1;
  }

  :global(.company-text) {
    font-weight: 700;
    color: var(--navy-950);
    font-size: 0.9rem;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    width: 100%;
  }

  @keyframes marquee-loop {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Shift by exactly half (1 list) plus half of the gap offset */
      transform: translateX(calc(-50% - 1.125rem));
    }
  }

  /* Skeleton Loading Styles */
  .placements-loader-container {
    width: 100%;
    margin-bottom: 4.5rem;
  }

  .skeleton-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .skeleton-header {
    width: 280px;
    height: 36px;
    background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
    background-size: 200% 100%;
    animation: loading-skeleton 1.5s infinite;
    border-radius: 6px;
  }

  .skeleton-table {
    width: 100%;
    height: 250px;
    background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
    background-size: 200% 100%;
    animation: loading-skeleton 1.5s infinite;
    border-radius: 12px;
  }

  @keyframes loading-skeleton {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
</style>
